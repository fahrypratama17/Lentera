# App
PORT=8080
JWT_SECRET=ganti-random-panjang
CORS_ORIGIN=http://localhost:3000
# produksi: CORS_ORIGIN=https://groupX.bccdev.id

# Postgres (dipakai container postgres DAN app)
POSTGRES_USER=lentera
POSTGRES_PASSWORD=ganti
POSTGRES_DB=lentera
DB_HOST=localhost
# di dalam docker compose: DB_HOST=postgres
DB_PORT=5432
DB_SSLMODE=disable
# opsional override penuh:
# DATABASE_URL=host=... port=... user=... password=... dbname=... sslmode=disable TimeZone=UTC

# Redis
REDIS_ADDR=localhost:6379
# di dalam docker compose: REDIS_ADDR=redis:6379

# Monitoring
GRAFANA_PASSWORD=ganti

# MinIO (Should Have, aktifkan kalau dipakai)
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=ganti-min-8-char